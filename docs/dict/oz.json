{"e":{"ozone":[{"pos":"noun","gloss":["An allotrope of oxygen (symbol O₃) having three atoms in the molecule instead of the usual two; it is a toxic gas, generated from oxygen by electrical discharge.","Fresh air, especially that breathed at the seaside and smelling of seaweed."],"fr":{"O3":["ozone"]},"syn":[]}],"ozone layer":[{"pos":"noun","gloss":["A region of the stratosphere, between 15 and 30 kilometres in altitude, containing a relatively high concentration of ozone, which absorbs most solar ultraviolet radiation."],"fr":{"a region of the stratosphere":["couche d'ozone","ozone"]},"syn":["ozone shield","ozonosphere"]}],"ozone hole":[{"pos":"noun","gloss":["A region of the stratosphere over Antarctica (and a smaller one over the Arctic) that is depleted of ozone in the local spring."],"fr":{"region of the stratosphere over Antarctica that is depleted of ozone in the local spring":["trou dans la couche d'ozone"]},"syn":[]}],"ozonization":[{"pos":"noun","gloss":["Reaction or treatment with ozone."],"fr":{"reaction or treatment":["ozonisation"]},"syn":[]}],"ozonic":[{"pos":"adj","gloss":["Of or pertaining to ozone."],"fr":{"of or pertaining to ozone":["ozonique","ozonal"]},"syn":[]}],"Ozurgeti":[{"pos":"name","gloss":["A city in Georgia, the regional capital of the region of Guria."],"fr":{"city in Georgia":["Ozourguéti"]},"syn":[]}]},"f":{"oz":[["ounce","noun","abbreviation"]],"ozonisation":[["ozonization","noun","alternative countable uncountable"]],"ozones":[["ozone","noun","plural"],["ozone","verb","indicative present singular third-person"]],"ozmazome":[["osmazome","noun","alternative uncountable"]],"ozonous":[["ozonic","adj","archaic"]],"ozier":[["osier","noun","alternative"]],"ozonizations":[["ozonization","noun","plural"]],"ozone holes":[["ozone hole","noun","plural"]],"ozoned":[["ozone","verb","participle past"]],"ozoning":[["ozone","verb","gerund participle present"]],"ozone layers":[["ozone layer","noun","plural"]],"ozt":[["troy ounce","noun","abbreviati